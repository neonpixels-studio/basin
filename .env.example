# ─────────────────────────────────────────────────────────────────────────────
# Reference of every variable the app reads. Real values are NOT kept here —
# they live ENCRYPTED in the committed dotenvx files:
#   .env             local dev          (key: DOTENV_PRIVATE_KEY)
#   .env.dev         Netlify previews   (key: DOTENV_PRIVATE_KEY_DEV)
#   .env.e2e         e2e tests / CI     (key: DOTENV_PRIVATE_KEY_E2E)
#   .env.production  Netlify production (key: DOTENV_PRIVATE_KEY_PRODUCTION)
#
# Change a value:  dotenvx set VAR "value" -f .env[.dev|.e2e|.production]
# Read decrypted:  dotenvx get -f .env
# Private keys live in .env.keys (gitignored). Back it up to your password
# manager — without it the encrypted files cannot be decrypted.
# Values are identical across environments EXCEPT the database URL, the Stripe
# keys, and NUXT_SITE_URL: .env.production holds Stripe LIVE-mode values; .env /
# .env.dev / .env.e2e hold TEST-mode (sandbox) values. NUXT_SITE_URL is the
# deployed origin per environment (localhost for local/e2e, the preview alias for
# .env.dev, the production origin for .env.production).
# ─────────────────────────────────────────────────────────────────────────────

# Neon DB connection string
# Used by drizzle-kit CLI (db:generate, db:migrate, db:push, db:studio)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Same value — Nuxt reads this and maps it to runtimeConfig.databaseUrl
NUXT_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# basin's own public base URL (scheme + host, no trailing path), e.g.
# https://basin.example.com — http://localhost:3000 for local dev. Nuxt maps it
# to runtimeConfig.siteUrl. Billing return/success/cancel URLs are anchored to
# this trusted origin instead of the request Host header, so a forged Host can't
# hijack the post-billing redirect (see server/utils/siteUrl.ts). Must be a valid
# absolute http(s) URL or billing requests fail with a 500.
NUXT_SITE_URL=http://localhost:3000

# Clerk — https://dashboard.clerk.com → API Keys
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NUXT_CLERK_SECRET_KEY=sk_test_...
# Clerk webhook signing secret — https://dashboard.clerk.com → Configure → Webhooks
# Create an endpoint pointing at <your-app-url>/api/clerk/webhook subscribed to
# the user.deleted event, then copy its "Signing Secret". Verifies user.deleted
# so a Clerk-side account deletion cascades cleanup into our database.
NUXT_CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Stripe — https://dashboard.stripe.com → Developers → API keys
# Toggle the dashboard's Test/Live switch per environment: TEST-mode ("sandbox")
# values go in .env / .env.dev / .env.e2e, LIVE-mode values in .env.production.
# Secret keys, webhook secrets, and Price IDs are ALL mode-specific — a test-mode
# value will not work againsst live data and vice versa.
# Secret key used server-side to create Checkout Sessions and read subscriptions.
NUXT_STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret — https://dashboard.stripe.com → Developers → Webhooks
# Create an endpoint pointing at <your-app-url>/api/billing/webhook subscribed to
# customer.subscription.created, customer.subscription.updated, and
# customer.subscription.deleted, then copy its "Signing secret".
NUXT_STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for the Pro plan — https://dashboard.stripe.com → Product catalog
# Create one Product ("Pro") with two recurring Prices (monthly, yearly) and
# paste each Price's ID (not the Product ID) here.
NUXT_STRIPE_PRICE_PRO_MONTHLY=price_...
NUXT_STRIPE_PRICE_PRO_YEARLY=price_...

# Public origin the app is served from (scheme + host, no trailing path). OAuth
# redirect URIs are built from this instead of the request origin so a forged Host
# header can't hijack the callback. Required — an unset/invalid value makes the
# OAuth routes return a 500. Local dev is http://localhost:3000; production is the
# deployed https origin. See server/utils/siteUrl.ts
NUXT_SITE_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com → APIs & Services → Credentials
# Enable YouTube Data API v3; add <NUXT_SITE_URL>/api/auth/youtube/callback as an
# authorized redirect URI (it must match NUXT_SITE_URL exactly)
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# AES-256-GCM key used to encrypt integration tokens at rest (YouTube OAuth
# tokens, Bluesky JWTs, Bluesky app password — see server/utils/crypto.ts and
# docs/api-auth-storage.md). Generate a fresh 32-byte key per environment —
# unlike most values in this file, this one should NOT be shared across
# environments, since a leaked non-prod key must never be able to decrypt
# production data:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Disable new user sign-ups (optional). When "true", existing users keep working
# but a newly-authenticated Clerk identity is rejected with a 403 instead of being
# created. Read via runtimeConfig, so it bakes into the build — set it only in the
# env file for the environment you want it in. It's set to "true" in .env.production
# (prod only) and left unset in .env / .env.dev / .env.e2e:
#   dotenvx set NUXT_DISABLE_SIGNUPS true -f .env.production
NUXT_DISABLE_SIGNUPS=

# Feed discovery SSRF allowlist (optional, for local dev / e2e only)
# Comma-separated list of host:port strings that bypass SSRF validation.
# Example: 127.0.0.1:3099 allows the local e2e mock server.
# NEVER set this in production.
NUXT_FEED_DISCOVERY_ALLOWED_HOSTS=

# Neon branch API — .env.e2e ONLY (not read by the app)
# The CI e2e job creates a fresh Neon branch per run and deletes it after, using
# these two values pulled from .env.e2e via `dotenvx get`. Keeping them in the
# encrypted file means CI needs only DOTENV_PRIVATE_KEY_E2E, no extra secrets.
#   NEON_API_KEY    — https://console.neon.tech → Account settings → API keys
#   NEON_PROJECT_ID — https://console.neon.tech → Project → Settings → General
NEON_API_KEY=
NEON_PROJECT_ID=

# Netlify Async Workloads — https://app.netlify.com → Project config → Build & Deploy → Async Workloads
# Required for the AsyncWorkloadsClient to authenticate when sending events.
# Generated automatically when you enable the Async Workloads extension; also available
# under Project configuration > Build & Deploy > Async Workloads → Create a new API key.
AWL_API_KEY=

# Sentry — https://sentry.io → Settings → Projects → <project> → Client Keys (DSN)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry source map uploads — https://sentry.io → Settings → Auth Tokens
# Token needs the `project:releases` scope
# SENTRY_ORG is your organization slug (visible in the Sentry URL: sentry.io/organizations/<slug>/)
# SENTRY_PROJECT is your project slug (visible under Settings → Projects → <project>)
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
