          <div data-v-d3b98f0f="" class="conn-since">@mychannel · Connected Jan 2024</div><span data-v-d3b98f0f="" class="feed-stat error" title="YouTube access token expired. Re-connect your YouTube account."><r-icon-stub data-v-d3b98f0f="" name="alertTriangle" size="12"></r-icon-stub> Needs reconnect</span>
        </div>
        <div data-v-d3b98f0f="" class="conn-buttons"><button data-v-d3b98f0f="" class="btn btn-primary"> Reconnect </button><button data-v-d3b98f0f="" class="btn">Disconnect</button></div>
      </div>
      <!--v-if-->
    </div>
    <div data-v-d3b98f0f="" class="conn">
      <div data-v-d3b98f0f="" class="conn-row"><span data-v-d3b98f0f="" class="conn-ic" style="--c: var(--src-tweet);"><r-icon-stub data-v-d3b98f0f="" name="chat" size="22"></r-icon-stub></span>
        <div data-v-d3b98f0f="" class="conn-info">
          <div data-v-d3b98f0f="" class="conn-name">Bluesky
            <!--v-if-->
          </div>
          <div data-v-d3b98f0f="" class="conn-desc">Subscribe to channels</div>
          <!--v-if-->
          <!--v-if-->
        </div>
        <div data-v-d3b98f0f="" class="conn-buttons">
          <!--v-if--><button data-v-d3b98f0f="" class="btn btn-primary">Connect</button>
