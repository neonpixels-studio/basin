{
  "name": "reader",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "TMPDIR=/tmp dotenvx run -f .env -- nuxt dev",
    "dev:test": "TMPDIR=/tmp nuxt dev",
    "build": "dotenvx run -f .env.production -- nuxt build",
    "build:dev": "dotenvx run -f .env.dev -- nuxt build",
    "preview": "dotenvx run -f .env.production -- nuxt preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "lint": "prettier --check . && eslint . && fallow audit",
    "lint:ci": "prettier --check . && eslint . && fallow audit --base origin/${BASE_BRANCH:-main}",
    "lint:fix": "prettier --write . && eslint . --fix && fallow fix",
    "prepare": "husky",
    "db:generate": "dotenvx run -f .env -- drizzle-kit generate",
    "db:migrate": "dotenvx run -f .env -- drizzle-kit migrate",
    "db:migrate:production": "dotenvx run -f .env.production -- drizzle-kit migrate",
    "db:push": "dotenvx run -f .env -- drizzle-kit push",
    "db:studio": "dotenvx run -f .env -- drizzle-kit studio",
    "tokens:backfill": "dotenvx run -f .env -- node scripts/backfill-encrypt-tokens.ts",
    "tombstones:backfill": "dotenvx run -f .env -- node scripts/backfill-hash-tombstones.ts",
    "e2e": "dotenvx run -f .env.e2e -- playwright test",
    "e2e:headed": "dotenvx run -f .env.e2e -- playwright test --headed",
    "e2e:ui": "dotenvx run -f .env.e2e -- playwright test --ui",
    "e2e:debug": "dotenvx run -f .env.e2e -- playwright test --debug",
    "e2e:report": "playwright show-report e2e/report"
  },
  "dependencies": {
    "@atproto/api": "^0.20.42",
    "@clerk/nuxt": "^3.0.15",
    "@dotenvx/dotenvx": "^2.21.0",
    "@electric-sql/pglite": "^0.5.7",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/async-workloads": "^0.0.106",
    "@netlify/functions": "^6.0.0",
    "@pinia/nuxt": "^1.0.2",
    "@sentry/nuxt": "^10.71.0",
    "dompurify": "^3.4.14",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.2",
    "rss-parser": "^3.13.0",
    "stripe": "^22.5.0"
  },
  "overrides": {
    "@netlify/sdk": "^5.0.4",
    "tmp": "^0.2.6",
    "http-proxy-middleware": "^4.1.1",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.5",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23",
    "shell-quote": "^1.10.0",
    "svgo": "^4.0.2"
  },
  "devDependencies": {
    "@clerk/backend": "^3.15.1",
    "@clerk/testing": "^2.2.30",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "fallow": "^3.18.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
